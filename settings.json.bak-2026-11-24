{
  "model": "opus[1m]",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/verify-hook"
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "high"
    }
  },
  "theme": "dark-daltonized",
  "switchModelsOnFlag": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "$defaults",
      "Trusted local folder: /Users/mk/.claude (the Marcdown setup)",
      "Trusted local folders: /Users/mk/Desktop/Staccato, /Users/mk/Desktop/staccato.run, /Users/mk/Documents/repo/b&t/Breidl & Travease, /Users/mk/Documents/vane/mqs, /Users/mk/Documents/vane/mqs-laptop, and their board folders beside them (folder names that end in .roadmap or .agents)"
    ]
  }
}
